# Copy to /etc/cinreco-web/deploy.env on the deployment host and fill in.
# Keep it root-owned and chmod 600 — it holds the demo credentials.
#
#   sudo install -d -m 700 /etc/cinreco-web
#   sudo install -m 600 deploy.env.example /etc/cinreco-web/deploy.env

# --- what to deploy ---------------------------------------------------------
REPO_URL=https://github.com/<owner>/movie-recommend-web.git
REPO_DIR=/opt/cinreco-web
IMAGE_REPO=ghcr.io/<owner>/movie-recommend-web
IMAGE_TAG=latest

# Only needed when the GHCR package is private. A public package pulls
# anonymously — leave both unset in that case.
#GHCR_USER=
#GHCR_TOKEN=

# --- how to verify ----------------------------------------------------------
# Hits Traefik on the host. HEALTH_HOST_HEADER must match the router rule,
# otherwise Traefik has no matching host and correctly answers 404.
HEALTH_URL=http://localhost:8060/healthz
HEALTH_HOST_HEADER=demo.example.com

# --- Terraform inputs -------------------------------------------------------
# Consumed by Terraform as TF_VAR_*. app_image is supplied by the agent, so
# it is deliberately absent here.
TF_VAR_docker_host=unix:///var/run/docker.sock
TF_VAR_public_domain=demo.example.com
TF_VAR_api_base_url=https://api.example.com/v1
TF_VAR_demo_email=
TF_VAR_demo_password=
