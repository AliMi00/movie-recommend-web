# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored —
# it holds the deployment's host and credentials, none of which belong in
# version control.

# Docker daemon over SSH. Use an ~/.ssh/config alias so no hostname or IP
# is written down here at all.
docker_host = "ssh://your-server-alias"

# Image to deploy. Pin to an immutable tag (a commit SHA) so a rollback is
# just changing this line back.
app_image = "ghcr.io/<owner>/movie-recommend-web:<commit-sha>"

# Hostname the upstream reverse proxy serves this app on.
public_domain = "demo.example.com"

# Host port Traefik listens on; the upstream proxy forwards here.
http_port = 8060

# Optional shared demo account. Leave empty to hide the demo login button.
demo_email    = ""
demo_password = ""

# Optional analytics. Empty disables it.
posthog_api_key = ""

# Grafana admin password. Required — there is no default, so a deployment
# cannot accidentally ship with a well-known one.
grafana_admin_password = ""

# ---------------------------------------------------------------------------
# Production (see prod.tf) — a second, independent deployment of the same
# image, no demo login, its own Traefik/ports. All of these have defaults
# in variables.tf; override here only to change them.
# ---------------------------------------------------------------------------
# prod_domain               = "app.cinreco.com"
# prod_api_base_url         = "https://api.cinreco.com/v1"
# prod_http_port            = 8066
# prod_metrics_port         = 8067
# prod_traefik_metrics_port = 8068
# prod_posthog_api_key      = ""
