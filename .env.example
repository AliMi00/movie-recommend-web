# CineJo Web - environment configuration example
# Copy to .env and fill in real values for local docker-compose use.
# In production these are injected as container env vars at startup —
# see entrypoint.sh, which substitutes them into web/build output at
# container boot ("build once, run anywhere").

# Base URL of the CineJo API this client talks to.
CINEJO_API_BASE_URL=https://api.gozaga.xyz/v1

# Optional shared demo account. When both are set, a "Continue with Demo
# Account" button appears on the login screen. Leave blank to disable it.
CINEJO_DEMO_EMAIL=
CINEJO_DEMO_PASSWORD=

# Optional PostHog analytics. Leave blank to keep analytics disabled.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
